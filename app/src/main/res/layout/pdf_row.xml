<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="10dp"
    app:cardElevation="5dp"
    android:layout_margin="5dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/pdfImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="21dp"
            android:layout_marginBottom="15dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/pdf" />

        <TextView
            android:id="@+id/row_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="25dp"
            app:layout_constraintStart_toEndOf="@id/pdfImage"
            app:layout_constraintEnd_toStartOf="@id/row_compressButton"
            app:layout_constraintTop_toTopOf="parent"
            android:fontFamily="@font/interblack"
            android:text="PDF FILE TITLE"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?colorOnSurface"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toEndOf="@id/pdfImage"
            app:layout_constraintTop_toBottomOf="@id/row_name"
            android:fontFamily="@font/interblack"
            android:text="20MB"
            android:textColor="?colorOnSurface"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@id/row_size"
            app:layout_constraintTop_toTopOf="@id/row_size"
            app:layout_constraintBottom_toBottomOf="@id/row_size"
            android:text="|"
            android:textColor="?colorOnSurface"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/row_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/row_name"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="@id/row_size"
            app:layout_constraintBottom_toBottomOf="@id/row_size"
            app:layout_constraintStart_toEndOf="@id/row_divider"
            android:fontFamily="@font/intermedium"
            android:text="ENTER DATE"
            android:textColor="?colorOnSurface"
            android:textSize="11sp" />


        <!-- Optimised to allow open file on card click  -->
<!--        <TextView-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_below="@id/row_name"-->
<!--            android:layout_marginStart="10dp"-->
<!--            android:layout_marginTop="6dp"-->
<!--            android:layout_toRightOf="@id/row_date"-->
<!--            android:text="|"-->
<!--            android:textColor="?colorOnSurface"-->
<!--            android:textSize="15sp" />-->

<!--        <TextView-->
<!--            android:id="@+id/row_open"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:layout_below="@id/row_name"-->
<!--            android:layout_marginStart="20dp"-->
<!--            android:layout_marginTop="11dp"-->
<!--            android:layout_toRightOf="@id/row_date"-->
<!--            android:fontFamily="@font/intermedium"-->
<!--            android:text="@string/open"-->
<!--            android:textColor="?colorOnSurface"-->
<!--            android:textSize="11sp" />-->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/row_compressButton"
            android:backgroundTint="#3B62DE"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="Compress"
            android:textColor="?colorOnSurface"
            android:fontFamily="@font/interextrabold"
            android:layout_marginEnd="5dp"
            android:textSize="11sp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>